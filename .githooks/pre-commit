#!/bin/sh
# VantaDB pre-commit — SHIM hacia .githooks/pre-commit-config.yaml (sistema único, FIND-339)
# Instalación: git config core.hooksPath .githooks  (NO ejecutar `pre-commit install`:
# escribiría en .git/hooks, ignorado bajo core.hooksPath).
# Con `pre-commit` instalado delega todos los gates deterministas (fmt, clippy,
# ruff, prettier, markdownlint). Sin él, fallback mínimo con cargo fmt.
# actionlint corre solo si está instalado (chequeo condicional heredado).
# STASH DESHABILITADO a propósito: este hook NUNCA escribe en el working tree
# (dos o más agentes comparten este checkout — FIND-726).
# Skips: SKIP=<hook-id> git commit  |  git commit --no-verify (solo emergencias)

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$REPO_ROOT"

FAILED=0

# DOC-04: Block .DS_Store, Thumbs.db, .zip, .tar.gz, .tgz
JUNK_STAGED=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(\.DS_Store|Thumbs\.db|\.zip|\.tar\.gz|\.tgz)$' || true)
if [ -n "$JUNK_STAGED" ]; then
    echo "ERROR [DOC-04]: Prohibited junk/binary files staged for commit:" >&2
    echo "$JUNK_STAGED" >&2
    exit 1
fi

if command -v pre-commit >/dev/null 2>&1; then
    # ── FIND-726: `pre-commit run` must never touch the working tree ──────────
    # Without --files/--all-files it REVERTS every tracked file to its index
    # content and replays the unstaged diff afterwards:
    #   pre_commit/commands/run.py -> stash = not args.all_files and not args.files
    # https://pre-commit.com/#pre-commit ("pre-commit only runs on the staged
    # contents of files by temporarily stashing the unstaged changes while
    # running hooks"). In a tree shared by several agents that revert/replay
    # destroyed other agents' work three times (FIND-720, FIND-721, FIND-723): a
    # write landing inside the window is silently dropped by the replay, and an
    # interrupted run leaves every tracked file reverted. Passing the staged list
    # explicitly (`--files`) keeps the same file set and makes `stash` False, so
    # this hook no longer reverts nor replays the tree. (It can still WRITE to it
    # through the formatters — ruff-format and prettier --write do that by design
    # and pre-commit reports "files were modified by this hook".)
    #
    # TRADE-OFF (measured, not assumed): hooks now read working-tree CONTENT, not
    # index content. The file SET is byte-identical to what pre-commit derives
    # itself (git.py::get_staged_files uses this exact diff command), but a
    # partially staged file is validated on the working-tree version while the
    # commit takes the index version — see the warning below. Whole-tree hooks
    # (cargo fmt --check, cargo clippy, verify_staged clippy) can now fail on a
    # file another agent is editing, and can report a false "files were modified"
    # if that agent writes during the run. Loud and non-destructive either way.
    # Bypass for a foreign file:
    #   SKIP=cargo-fmt,cargo-clippy git commit ...
    # REJECTED: aborting whenever foreign WIP exists. WIP is the normal state of
    # this checkout (measured 2026-11-25: `M src/executor.rs` while FIND-722 ran),
    # so an unconditional abort would block every commit and push everybody to
    # --no-verify, which removes the gate entirely.

    # pre-commit only enforces these two guards in stash mode; keep them here.
    UNMERGED=$(git ls-files --unmerged)
    if [ -n "$UNMERGED" ]; then
        echo "ERROR [FIND-726]: unmerged paths present — resolve before committing:" >&2
        echo "$UNMERGED" | sed 's/^/  /' >&2
        exit 1
    fi
    # Mirror upstream `_has_unstaged_config`: only exit code 1 means "unstaged".
    if git diff --quiet --no-ext-diff -- .githooks/pre-commit-config.yaml; then
        :
    else
        CONFIG_RC=$?
        if [ "$CONFIG_RC" -eq 1 ]; then
            echo "ERROR: .githooks/pre-commit-config.yaml has unstaged changes — the gates" >&2
            echo "       must run the staged config. Fix: git add .githooks/pre-commit-config.yaml" >&2
            exit 1
        fi
        echo "pre-commit: WARNING — git diff exited $CONFIG_RC checking the config; continuing." >&2
    fi

    # F1 (P2-01): guard on the SAME filtered list that feeds --files. With only
    # deletions staged the unfiltered list is non-empty while the filtered one is
    # empty, and `pre-commit run --files` with zero args means `files == []`
    # -> stash = True -> the revert/replay comes back.
    STAGED_FILTERED=$(git diff --staged --name-only --no-ext-diff --diff-filter=ACMRTUXB)
    if [ -z "$STAGED_FILTERED" ]; then
        echo "pre-commit: nothing to check (no staged file with content); yaml gates skipped."
    else
        WIP_LIST=$(git diff --name-only --no-ext-diff)
        if [ -n "$WIP_LIST" ]; then
            echo "pre-commit: [FIND-726] unstaged changes in tracked files — left untouched:"
            echo "$WIP_LIST" | head -n 10 | sed 's/^/  /'
            echo "pre-commit: whole-tree gates (cargo fmt --check, clippy) do see them."
            echo "pre-commit: if one fails on a file you did not stage, use:"
            echo "pre-commit:   SKIP=cargo-fmt,cargo-clippy git commit ..."
        fi
        # F2 (P2-01): a file that is staged AND modified is validated on its
        # working-tree content but committed from the index. Only this subset can
        # disagree with the commit, so name it instead of hiding the gap.
        PARTIAL=$(git diff --name-only --no-ext-diff | while IFS= read -r f; do
            if printf '%s\n' "$STAGED_FILTERED" | grep -qxF -- "$f"; then
                printf '%s\n' "$f"
            fi
        done)
        if [ -n "$PARTIAL" ]; then
            echo "pre-commit: [FIND-726] partially staged — hooks validated the WORKING-TREE"
            echo "pre-commit: version, the commit takes the INDEX version:"
            echo "$PARTIAL" | head -n 10 | sed 's/^/  /'
        fi
        echo "pre-commit: running .githooks/pre-commit-config.yaml gates (no stash)..."
        # -0 keeps paths with spaces intact; -r is belt-and-suspenders against the
        # empty-list case above; --files is what disables the stash.
        if git diff --staged --name-only --no-ext-diff -z --diff-filter=ACMRTUXB \
            | xargs -0 -r pre-commit run --config "$REPO_ROOT/.githooks/pre-commit-config.yaml" --show-diff-on-failure --files; then
            echo "pre-commit: gates passed."
        else
            FAILED=1
        fi
    fi
else
    echo "pre-commit: binary not found (pipx install pre-commit). Minimal fallback:"
    STAGED_RS=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.rs$' || true)
    if [ -n "$STAGED_RS" ]; then
        if command -v cargo >/dev/null 2>&1; then
            if cargo fmt --all -- --check 2>/dev/null; then
                echo "pre-commit: cargo fmt ok."
            else
                echo "pre-commit: cargo fmt FAILED. Run: cargo fmt"
                FAILED=1
            fi
        else
            echo "pre-commit: cargo not found, skipping fmt (no verification)."
        fi
    else
        echo "pre-commit: no staged Rust files; nothing to check."
    fi
fi

# verify_staged: fast multi-area gate (touched members/standalone/skills).
# The yaml covers core (-p vantadb), ruff, prettier, docs markdownlint.
# NOTE (Windows/Git Bash): powershell.exe cannot read /mnt-style paths —
# convert once via cygpath (buffered in WIN_PS1).
# Native Windows PowerShells need a Windows path even when called from
# Git Bash/WSL (/c/... or /mnt/c/...). Pure-POSIX conversion, no deps.
winpath() {
    case "$1" in
        /mnt/[a-zA-Z]/*) p=$(echo "$1" | cut -c6-); d=$(echo "$p" | cut -c1 | tr 'a-z' 'A-Z'); r=$(echo "$p" | cut -c3- | tr '/' '\\'); printf '%s:%s' "$d" "\\$r" ;;
        /[a-zA-Z]/*) d=$(echo "$1" | cut -c2 | tr 'a-z' 'A-Z'); r=$(echo "$1" | cut -c3- | tr '/' '\\'); printf '%s:%s' "$d" "\\$r" ;;
        *) printf '%s' "$1" ;;
    esac
}
if [ "$FAILED" -eq 0 ]; then
    STAGED_PS1_WIN="$(winpath "$REPO_ROOT/dev-tools/verify_staged.ps1")"
    if command -v pwsh >/dev/null 2>&1; then
        if pwsh -NoProfile -File "$STAGED_PS1_WIN"; then
            echo "pre-commit: staged-area gate passed."
        else
            FAILED=1
        fi
    elif command -v powershell.exe >/dev/null 2>&1; then
        if command -v cygpath >/dev/null 2>&1; then
            STAGED_PS1_WIN="$(cygpath -w "$REPO_ROOT/dev-tools/verify_staged.ps1")"
        fi
        if powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$STAGED_PS1_WIN"; then
            echo "pre-commit: staged-area gate passed."
        else
            FAILED=1
        fi
    else
        echo "pre-commit: no PowerShell, skipping staged-area gate (yaml gates still ran)."
    fi
fi

# actionlint (GitHub Actions YAML, solo si está instalado — condicional heredado)
if command -v actionlint >/dev/null 2>&1; then
    echo "pre-commit: running actionlint..."
    if actionlint 2>/dev/null; then
        echo "pre-commit: actionlint ok."
    else
        echo "pre-commit: actionlint FAILED."
        FAILED=1
    fi
else
    echo "pre-commit: actionlint not found (winget install actionlint), skipped."
fi

if [ "$FAILED" -ne 0 ]; then
    echo "pre-commit: gates FAILED — commit blocked. Triage: docs/dev/references/troubleshooting.md § git hooks" >&2
fi

exit $FAILED
