#!/bin/sh
# VantaDB pre-commit — SHIM hacia .githooks/pre-commit-config.yaml (sistema único, FIND-339)
# Instalación: git config core.hooksPath .githooks  (NO ejecutar `pre-commit install`:
# escribiría en .git/hooks, ignorado bajo core.hooksPath).
# Con `pre-commit` instalado delega todos los gates deterministas (fmt, clippy,
# ruff, prettier, markdownlint). Sin él, fallback mínimo con cargo fmt.
# actionlint corre solo si está instalado (chequeo condicional heredado).
# Skips: SKIP=<hook-id> git commit  |  git commit --no-verify (solo emergencias)

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$REPO_ROOT"

FAILED=0

if command -v pre-commit >/dev/null 2>&1; then
    echo "pre-commit: running .githooks/pre-commit-config.yaml gates..."
    if pre-commit run --config "$REPO_ROOT/.githooks/pre-commit-config.yaml" --show-diff-on-failure "$@"; then
        echo "pre-commit: gates passed."
    else
        FAILED=1
    fi
else
    echo "pre-commit: binary not found (pipx install pre-commit). Minimal fallback:"
    STAGED_RS=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.rs$' || true)
    if [ -n "$STAGED_RS" ]; then
        if command -v cargo >/dev/null 2>&1; then
            if cargo fmt --all -- --check 2>/dev/null; then
                echo "pre-commit: cargo fmt ok."
            else
                echo "pre-commit: cargo fmt FAILED. Run: cargo fmt"
                FAILED=1
            fi
        else
            echo "pre-commit: cargo not found, skipping fmt (no verification)."
        fi
    else
        echo "pre-commit: no staged Rust files; nothing to check."
    fi
fi

# actionlint (GitHub Actions YAML, solo si está instalado — condicional heredado)
if command -v actionlint >/dev/null 2>&1; then
    echo "pre-commit: running actionlint..."
    if actionlint 2>/dev/null; then
        echo "pre-commit: actionlint ok."
    else
        echo "pre-commit: actionlint FAILED."
        FAILED=1
    fi
else
    echo "pre-commit: actionlint not found (winget install actionlint), skipped."
fi

exit $FAILED
