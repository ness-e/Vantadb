{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek-v4-flash-free",
  "small_model": "deepseek-v4-flash-free",
  "subagent_depth": 2,
  "plugins": [
    "C:/Users/Eros/.agents/ponytail/.opencode/plugins/ponytail.mjs"
  ],
  "experimental": {
    "disable_paste_summary": true
  },
  "mcp": {
    "servers": {
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "disabled": false
    },
      "codebase-memory-mcp": {
        "type": "local",
        "command": [
          "C:\\Users\\Eros\\AppData\\Local\\Programs\\codebase-memory-mcp\\codebase-memory-mcp.exe"
        ],
        "disabled": false,
        "description": "Codebase knowledge graph (tree-sitter, 158 langs, semantic + BM25 search, Cypher, architecture, change impact, dead-code, ADR). Complementa a CodeGraph. Skill: codebase-memory. Absolute path used because OpenCode's process PATH doesn't include the user PATH entry the installer added."
      },
    "discord": {
      "type": "local",
      "command": [
        "pwsh",
        "-NoProfile",
        "-Command",
        "$t = (Get-Content '.env.tokens' | Where-Object {$_ -match '^DISCORD_BOT_TOKEN=\"(.+)\"$'} | ForEach-Object {$Matches[1]}); $env:DISCORD_TOKEN = $t; bunx @rayenking/discord-mcp"
      ],
      "disabled": false
    },
    "metasearchmcp": {
      "command": [
        "metasearchmcp-mcp"
      ],
      "disabled": false,
      "type": "local",
      "description": "Búsqueda multi-provider: web, GitHub, académico, código. DuckDuckGo gratis sin key."
    },
    "argus": {
      "command": [
        "argus",
        "mcp",
        "serve"
      ],
      "disabled": false,
      "type": "local",
      "description": "14 providers, extracci�n 12-step, dead URL recovery, RRF fusion."
    },
    "agent-search": {
      "command": [
        "npx",
        "-y",
        "agent-search-mcp"
      ],
      "disabled": false,
      "type": "local",
      "description": "Capa keyless permanente: busqueda multi-engine gratis sin API keys (respaldo de metasearchmcp/argus)."
    },
    "campaign": {
      "command": [
        "bun",
        ".opencode/task-system/mcp/campaign-server.mjs"
      ],
      "disabled": false,
      "type": "local",
      "description": "Plan de campaña: get_next_task, update_task_state, verify_cmd."
    },
    "vantadb": {
      "command": [
        "vanta-cli",
        "server",
        "--mcp",
        "--db",
        "C:/Users/Eros/.vantadb"
      ],
      "disabled": false,
      "type": "local",
      "description": "VantaDB MCP — memoria persistente y vector retrieval (87 tools en perfil full: memory, threads, scenes, dreams, graph, wiki, skills, code...)."
    },
    "lottiefiles-creator": {
      "command": [
        "bunx",
        "@lottiefiles/creator-mcp@latest"
      ],
      "disabled": true,
      "type": "local",
      "description": "LottieFiles Creator MCP — crear y editar animaciones Lottie via IA."
    },
    "playwright": {
      "command": [
        "npx",
        "@playwright/mcp@latest",
        "--viewport-size",
        "1440x900"
      ],
      "disabled": false,
      "type": "local",
      "timeout": 120000,
      "description": "Playwright MCP — automatización de browser via accessibility tree (browser_navigate/snapshot/click/type/evaluate). Para testing web/, E2E desktop/ y visual review."
    }
    }
  }
}
