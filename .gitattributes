# Normalize line endings
* text=auto eol=lf

# Shell scripts must stay LF
*.sh text eol=lf

# PowerShell scripts
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.ico binary
*.woff2 binary
*.bin binary
*.gif binary

# FIND-631: v0.9.0 on-disk fixture must stay byte-exact (no EOL normalisation)
tests/fixtures/v0.9.0/** binary
