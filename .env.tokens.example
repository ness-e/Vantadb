# ──────────────────────────────────────────────────────────────────────────────
# VantaDB — Tokens & Secrets Template
# ──────────────────────────────────────────────────────────────────────────────
# Copia este archivo a `.env.tokens` (está en .gitignore) y completa los
# valores reales. Cada sección indica dónde se usa cada token.
# ──────────────────────────────────────────────────────────────────────────────

# ── 1. VantaDB Server ─────────────────────────────────────────────────────────
# Usado en: src/config.rs, src/cli_server.rs
# Protege endpoints HTTP con autenticación Bearer.
# VANTADB_API_KEY=""

# Clave de cifrado AES-256-GCM para datos en reposo (64 hex chars = 32 bytes).
# Usado en: src/crypto.rs, src/config.rs (feature "encryption")
# Generar con: openssl rand -hex 32
# VANTADB_ENCRYPTION_KEY=""

# ── 1b. Secrets que el código lee (faltaban en este template) ─────────────────
# Usado en: src/config.rs — sin documentar hasta 2026-10-30.
# VANTADB_JWT_SECRET=""              # firma de tokens JWT (servidor)
# VANTADB_OPENAI_API_KEY=""          # provider OpenAI por entorno
# VANTADB_ALT_API_KEY=""             # API key de proveedor alternativo
# VANTADB_ENCRYPTION_KEY_FILE=""     # ruta al fichero de clave (feature encryption)
# VANTADB_ENCRYPTION_KEY_CMD=""      # comando que entrega la clave (feature encryption)

# ── 2. API Keys de Embeddings/LLM (programáticos) ─────────────────────────────
# Se pasan como argumentos al constructor de cada adapter, no como env vars.
# Usado en: vantadb-openai/src/python.rs
# VantaDBOpenAI(db_path, api_key="sk-...", model="text-embedding-3-small")

# Usado en: vantadb-litellm/src/python.rs
# VantaDBLiteLLM(db_path, api_key="...", model="text-embedding-3-small")

# ── 3. PyPI Publishing ────────────────────────────────────────────────────────
# Usado en: .github/workflows/release-wheels.yml, release-adapters.yml,
#           release-providers.yml
# La realidad (verificada 2026-10-30): el publish usa TOKEN ESTÁTICO
# (`password: secrets.PYPI_TOKEN` / `TEST_PYPI_TOKEN`), aunque `id-token: write`
# esté declarado. OIDC solo se usa para crates.io.
# También necesitas:
#   - Entorno "release" configurado en GitHub
#   - PyPI project registrado: https://pypi.org/manage/project/vantadb-py/
#   - TestPyPI project registrado: https://test.pypi.org/manage/project/vantadb-py/

# ── 4. npm Publishing ─────────────────────────────────────────────────────────
# Usado en: .github/workflows/release-npm-node.yml, release-npm-wasm.yml
# Igual que PyPI: `NODE_AUTH_TOKEN: secrets.NPM_TOKEN` es lo que publica hoy.
# OIDC/provenance está declarado pero el token gana; migrar requiere cambiar el
# workflow, no solo el entorno.

# ── 5. GitHub Secrets (Actions) ───────────────────────────────────────────────
# Configurados en: https://github.com/ness-e/Vantadb/settings/secrets/actions
# Automáticos (no requieren configuración manual):
#   - secrets.GITHUB_TOKEN  → release.yml (upload assets)
#   - github.token (GH_TOKEN) → release-wheels-60.yml (attestation verify)
#   - id-token: write       → OIDC trusted publishing (no es secret estático)

# ── 6. OpenTelemetry (opcional) ────────────────────────────────────────────────
# Usado en: src/cli_server.rs (feature "opentelemetry")
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4317"
# OTEL_SERVICE_NAME="vantadb-server"

# ── 7. Storage Backend ─────────────────────────────────────────────────────────
# Usado en: src/config.rs
# VANTADB_STORAGE_PATH="./vantadb_data"
# VANTADB_BACKEND="fjall"        # fjall | rocksdb | memory

# ── 8. TLS (opcional) ─────────────────────────────────────────────────────────
# Usado en: src/config.rs (feature "tls")
# VANTADB_TLS_CERT="./cert.pem"
# VANTADB_TLS_KEY="./key.pem"

# ══════════════════════════════════════════════════════════════════════════
# 9. LLM Server ═══════════════════════════════════════════════════════════
# Usado en: src/config.rs, src/llm.rs
# VANTADB_LLM_URL="http://localhost:11434"
# VANTADB_LLM_MODEL="all-minilm"
# VANTADB_LLM_SUMMARIZE_MODEL="llama3"

# ══════════════════════════════════════════════════════════════════════════
# 10. Performance Tuning ═══════════════════════════════════════════════════
# Usado en: src/config.rs, src/index/core.rs
# VANTADB_RATE_LIMIT_RPM="600"
# VANTADB_MAX_BLOCKING_THREADS="16"
# VANTADB_WAL_SHARDS="4"
# VANTADB_FLUSH_THRESHOLD="10000"
# VANTADB_WAL_BUFFER_SIZE="65536"
# VANTA_PREFETCH="auto"          # DEPRECATED: renamed to VANTADB_PREFETCH (ADR-0043)
# VANTADB_PREFETCH="auto"        # enabled | disabled | auto
